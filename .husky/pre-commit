#!/usr/bin/env sh
# ──────────────────────────────────────────────────────────────
# Pre-commit hook — secure-devsecops-platform
# Purpose: Run gitleaks to scan staged files for secrets BEFORE
#          they enter the git history.
#
# What this catches:
#   - Secrets (API keys, passwords, tokens) that are about to
#     be committed in the staged diff.
#
# What this does NOT catch:
#   - Secrets that were committed in PREVIOUS commits (use
#     `gitleaks detect` with --log-opts for full history scan).
#   - Secrets in unstaged files (only staged content is checked).
#   - Secrets that don't match gitleaks' rule patterns (custom
#     formats or obfuscated secrets may slip through).
#   - Secrets committed by other contributors who don't have
#     this hook installed (CI Gitleaks job is the safety net).
#
# The CI pipeline runs `gitleaks detect` on the FULL history as
# a second layer of defence (Phase 7).
# ──────────────────────────────────────────────────────────────

echo "🔍 Running gitleaks on staged changes..."

# --staged: only scan what is about to be committed
# --verbose: show details of any findings
gitleaks protect --staged --verbose

# If gitleaks finds a secret, it exits non-zero and blocks the commit.
# To bypass in an emergency (NOT recommended):
#   git commit --no-verify -m "message"
# But remember: if the secret was staged, it may already be in memory
# or temp files. Rotation is the only safe response to a leak.
