# ──────────────────────────────────────────────────────────────
# .env.example — secure-devsecops-platform
# Purpose: Document all required environment variables with
#          PLACEHOLDER values only. Copy to .env and fill in
#          real values locally. NEVER commit the actual .env.
# Security: No real secrets, passwords, or keys in this file.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Admin credentials (used only for DB initialisation)
POSTGRES_USER=CHANGE_ME_admin
POSTGRES_PASSWORD=CHANGE_ME_admin_password

# Per-service database names
USERS_DB_NAME=usersdb
PRODUCTS_DB_NAME=productsdb
ORDERS_DB_NAME=ordersdb

# Per-service database credentials (least-privilege roles)
USERS_DB_USER=CHANGE_ME_users_svc
USERS_DB_PASSWORD=CHANGE_ME_users_password
PRODUCTS_DB_USER=CHANGE_ME_products_svc
PRODUCTS_DB_PASSWORD=CHANGE_ME_products_password
ORDERS_DB_USER=CHANGE_ME_orders_svc
ORDERS_DB_PASSWORD=CHANGE_ME_orders_password

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_a_random_64_char_string
JWT_ISSUER=secure-devsecops-platform
JWT_AUDIENCE=secure-devsecops-platform
JWT_EXPIRY=15m

# ── Services ─────────────────────────────────────────────────
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
API_GATEWAY_PORT=3000
FRONTEND_PORT=8080

# ── Service URLs (for inter-service communication) ───────────
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
