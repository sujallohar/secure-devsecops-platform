# ──────────────────────────────────────────────────────────────
# .gitignore — secure-devsecops-platform
# Purpose: Prevent committing build artifacts, secrets, IDE
#          config, and other non-source files to version control.
# ──────────────────────────────────────────────────────────────

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ── Build output ─────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Coverage & test artifacts ────────────────────────────────
coverage/
.nyc_output/
junit.xml
test-results/

# ── Environment & secrets (NEVER commit these) ──────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml

# ── Terraform ────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.Spotlight-V100
.Trashes
ehthumbs.db

# ── Security evidence (auto-generated, not hand-crafted) ────
# Note: security/evidence/ contains timestamped scan results.
# These are committed intentionally but should never be
# manually fabricated — only tool-generated outputs.

# ── Miscellaneous ────────────────────────────────────────────
*.log
tmp/
temp/
