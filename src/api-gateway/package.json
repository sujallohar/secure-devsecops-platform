{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway — JWT verification, rate limiting, security headers, request proxying",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --forceExit",
    "lint": "for f in src/*.js src/**/*.js; do [ -f \"$f\" ] && node --check \"$f\"; done"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.0"
  }
}
