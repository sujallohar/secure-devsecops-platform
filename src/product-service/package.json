    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.1.0"
  }
}
